# ==============================================================================
# Chapter & Chats - Backend Environment Configuration Example
# Copy this file to .env or backend/.env and update the values for your environment.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Django Core & Security
# ------------------------------------------------------------------------------
# Set a unique, unguessable secret key in production
SECRET_KEY=django-insecure-change-this-to-a-secure-secret-key-in-production

# Set DEBUG to False in production!
DEBUG=True

# Comma-separated list of allowed hostnames/IPs (use * for local dev only)
ALLOWED_HOSTS=localhost,127.0.0.1,*

# ------------------------------------------------------------------------------
# 2. Database Configuration
# ------------------------------------------------------------------------------
# Default is SQLite (requires only DB_NAME or leaves default db.sqlite3)
DB_ENGINE=django.db.backends.sqlite3
DB_NAME=db.sqlite3

# For PostgreSQL in production, uncomment and configure:
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=chapter_and_chats
# DB_USER=postgres
# DB_PASSWORD=your_database_password
# DB_HOST=localhost
# DB_PORT=5432

# ------------------------------------------------------------------------------
# 3. CORS Configuration (Cross-Origin Resource Sharing)
# ------------------------------------------------------------------------------
# Comma-separated list of trusted frontend origins
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Allow all origins (set to False in production)
CORS_ALLOW_ALL_ORIGINS=True

# ------------------------------------------------------------------------------
# 4. Telegram Bot Integration
# ------------------------------------------------------------------------------
# Token obtained from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
# Username of your Telegram bot (without leading @)
TELEGRAM_BOT_USERNAME=chapter_and_chats_bot

# ------------------------------------------------------------------------------
# 5. Email Configuration
# ------------------------------------------------------------------------------
# For development, console backend prints reset emails to terminal:
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=Chapter & Chats <noreply@chapterandchats.org>

# For production SMTP (e.g. Sendgrid, Gmail SMTP, AWS SES), configure:
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=your_email@gmail.com
# EMAIL_HOST_PASSWORD=your_app_specific_password

